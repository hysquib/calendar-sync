    "@microsoft/microsoft-graph-client": "^3.0.7",
    "axios": "^1.6.7",
    "cheerio": "^1.0.0-rc.12",
    "cron": "^3.1.6",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "isomorphic-fetch": "^3.0.0",
    "node-cron": "^3.0.3",
    "puppeteer": "^22.6.5",
    "ws": "^8.16.0",
    "winston": "^3.12.0"
  },
  "engines": {
    "node": ">=18.0.0"
