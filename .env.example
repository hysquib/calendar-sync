# ============================================
# 日历同步服务配置文件
# 复制此文件为 .env 并填写实际配置
# ============================================

# ---- 服务配置 ----
PORT=3000
# 同步 cron 表达式，默认每小时同步一次
SYNC_CRON="0 * * * *"
# 时区
TIMEZONE=Asia/Shanghai

# ---- 喜鹊儿课表配置 ----
# 喜鹊儿登录账号（学号/工号）
XIQUEER_USERNAME=
# 喜鹊儿登录密码
XIQUEER_PASSWORD=
# 学校名称（在喜鹊儿中选择的学校全称）
XIQUEER_SCHOOL=
# 提前获取课表的天数
XIQUEER_DAYS_AHEAD=14
# 课表日历名称
XIQUEER_CALENDAR_NAME=课程表

# ---- 教务系统课表配置（推荐，比喜鹊儿更稳定） ----
# 教务系统根地址（到 cas/login.action 之前的路径）
# 例如：https://jw.hebust.edu.cn/hbkjjw/
JWXT_BASE_URL=
# 学号/用户名（用于标识登录状态）
JWXT_USERNAME=
# 提前获取课表的天数
JWXT_DAYS_AHEAD=14
# 课表日历名称
JWXT_CALENDAR_NAME=课程表

# ---- 企业微信待办配置 ----
# 企业微信企业ID
WECOM_CORP_ID=
# 企业微信应用Secret
WECOM_SECRET=
# 企业微信应用AgentId
WECOM_AGENT_ID=
# 待办同步的用户ID（多个用逗号分隔）
WECOM_USER_IDS=
# 待办日历名称
WECOM_CALENDAR_NAME=企业待办
# 待办事项默认时长（分钟）
WECOM_TODO_DURATION=60

# ---- 同步目标配置 ----
# 选择同步目标：caldav（自建CalDAV服务器）或 graph（Microsoft Exchange/Outlook）
SYNC_TARGET=caldav

# ---- CalDAV 配置（推荐，自建服务器） ----
# 是否启用 CalDAV
CALDAV_ENABLED=true
# CalDAV 服务器地址（Docker部署默认使用 radicale 服务）
CALDAV_SERVER_URL=http://radicale:5232/
# CalDAV 用户名
CALDAV_USERNAME=admin
# CalDAV 密码
CALDAV_PASSWORD=admin123
# 默认日历名称
CALDAV_DEFAULT_CALENDAR=calendar

# ---- Microsoft Graph / Outlook 配置 ----
# Azure AD 应用注册 - 客户端ID
MS_GRAPH_CLIENT_ID=
# Azure AD 应用注册 - 客户端密钥
MS_GRAPH_CLIENT_SECRET=
# Azure AD 租户ID
MS_GRAPH_TENANT_ID=
# 要同步的目标邮箱地址
MS_GRAPH_USER_EMAIL=
# 使用 Microsoft 365 还是 Exchange Server
# 可选值: "graph" (Microsoft 365 Graph API) 或 "ews" (Exchange Web Services)
MS_GRAPH_API_TYPE=graph
# Exchange Server 地址（仅当 API_TYPE=ews 时需要）
EXCHANGE_SERVER_URL=
# Exchange 用户名（仅当 API_TYPE=ews 时需要）
EXCHANGE_USERNAME=
# Exchange 密码（仅当 API_TYPE=ews 时需要）
EXCHANGE_PASSWORD=

# ---- iOS 日历说明 ----
# 方式一：CalDAV（推荐，使用自建 Radicale）
# 设置 → 日历 → 账户 → 添加账户 → 其他 → 添加 CalDAV 账户
# 服务器：http://你的服务器IP:5232/
# 用户名：admin
# 密码：admin123
#
# 方式二：Microsoft Exchange
# 设置 → 日历 → 账户 → 添加账户 → Exchange
# 使用上面配置的邮箱地址和密码登录
# 服务器地址：outlook.office365.com（Microsoft 365）或您的Exchange服务器地址
